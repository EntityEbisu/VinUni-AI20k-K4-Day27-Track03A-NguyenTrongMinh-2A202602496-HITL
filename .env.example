# LLM provider (OpenRouter is OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# SQLite database path (optional — defaults to ./hitl_audit.db in CWD)
# HITL_DB_PATH=hitl_audit.db

# GitHub Personal Access Token — REQUIRED.
#
# The agent calls the GitHub REST API directly. Generate a token at:
#   https://github.com/settings/tokens/new
# Scopes: tick `public_repo` (enough for VinUni-AI20k/PR-Demo — it's a public repo).
#
# Posting a top-level PR comment works for any authenticated user on a public repo.
# Formal reviews (Approve/Request-changes) would need collaborator status on the target.
GITHUB_TOKEN=

# GitHub login của người duyệt — được ghi vào cột `reviewer_id` của bảng audit_events.
GITHUB_USER=your-github-login

# ── Provider thay thế (mặc định lab này dùng OpenCode Go) ────────────────────
# LLM_BASE_URL + LLM_MODEL ở trên trỏ tới bất kỳ endpoint OpenAI-compatible nào.
# OpenCode Go (https://opencode.ai/zen/go/v1) BẮT BUỘC header `x-opencode-session`
# (thiếu -> HTTP 400 MissingSessionID) và nên có User-Agent riêng (UA mặc định của
# thư viện Python bị Cloudflare chặn 403/1010). SDK openai đọc các header này từ
# OPENAI_CUSTOM_HEADERS theo định dạng nhiều dòng "Tên: giá trị", nên KHÔNG cần sửa
# common/llm.py:
# OPENAI_CUSTOM_HEADERS="x-opencode-session: day27-minh-001
# User-Agent: Day27-HITL-Lab/0.1"
LLM_FALLBACK_MODEL=deepseek-v4.1-flash
LLM_SESSION_ID=day27-minh-001
